local function execNative(cmdText)
    local lp = LocalPlayer
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local args = cmdText:split(" ")
    local cmd = args[1]:lower()

    local function getPlayerByName(name)
        if not name then return nil end
        if name:lower() == "all" then return "all" end
        if name:lower() == "others" then return "others" end
        if name:lower() == "me" then return lp end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= lp and p.Name:lower():sub(1, #name) == name:lower() then return p end
        end
        return nil
    end

    local ok = false
    if cmd == "speed" or cmd == "ws" then
        local n = tonumber(args[2]); if n and hum then hum.WalkSpeed = n; ok = true end
    elseif cmd == "jumppower" or cmd == "jp" then
        local n = tonumber(args[2]); if n and hum then hum.UseJumpPower = true; hum.JumpPower = n; ok = true end
    elseif cmd == "hipheight" or cmd == "hh" then
        local n = tonumber(args[2]); if n and hum then hum.HipHeight = n; ok = true end
    elseif cmd == "default" then
        if hum then hum.WalkSpeed = 16; hum.UseJumpPower = true; hum.JumpPower = 50; hum.HipHeight = 0; ok = true end
    elseif cmd == "noclip" then
        getgenv()._noclip = true
        if not getgenv()._noclipConn then
            getgenv()._noclipConn = RunService.Stepped:Connect(function()
                if getgenv()._noclip and lp.Character then
                    for _, part in ipairs(lp.Character:GetDescendants()) do
                        if part:IsA("BasePart") then part.CanCollide = false end
                    end
                end
            end)
        end
        ok = true
    elseif cmd == "clip" then getgenv()._noclip = false; ok = true
    elseif cmd == "reset" or cmd == "respawn" or cmd == "grespawn" then
        if hum then hum.Health = 0; ok = true end
    elseif cmd == "god" then
        if hum then hum.Name = "1"; local l = char["1"]:Clone(); l.Parent = char; l.Name = "Humanoid"; task.wait(0.1); char["1"]:Destroy(); ok = true end
    elseif cmd == "goto" then
        local t = getPlayerByName(args[2])
        if type(t) == "Instance" and t.Character and t.Character:FindFirstChild("HumanoidRootPart") and hrp then
            hrp.CFrame = t.Character.HumanoidRootPart.CFrame; ok = true
        elseif t == "all" or t == "others" then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= lp and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and hrp then
                    hrp.CFrame = p.Character.HumanoidRootPart.CFrame; ok = true; break
                end
            end
        end
    elseif cmd == "view" then
        local t = getPlayerByName(args[2])
        if type(t) == "Instance" and t.Character then
            local h = t.Character:FindFirstChildOfClass("Humanoid")
            if h then workspace.CurrentCamera.CameraSubject = h; ok = true end
        end
    elseif cmd == "unview" or cmd == "fixcam" then
        if hum then workspace.CurrentCamera.CameraSubject = hum; ok = true end
    elseif cmd == "drophats" then
        if char then for _, v in ipairs(char:GetChildren()) do if v:IsA("Accessory") or v:IsA("Hat") then v.Parent = workspace end end; ok = true end
    elseif cmd == "droptool" then
        if char then for _, v in ipairs(char:GetChildren()) do if v:IsA("Tool") then v.Parent = workspace end end; ok = true end
    elseif cmd == "invisible" then
        if char then for _, v in ipairs(char:GetDescendants()) do if v:IsA("BasePart") then v.Transparency = 1 end if v:IsA("Decal") then v.Transparency = 1 end end; ok = true end
    elseif cmd == "removefog" then Lighting.FogStart = 0; Lighting.FogEnd = 999999999; ok = true
    elseif cmd == "getplrs" then for _, p in ipairs(Players:GetPlayers()) do print(p.Name) end; ok = true
    elseif cmd == "gravity" then local n = tonumber(args[2]); if n then workspace.Gravity = n; ok = true end
    elseif cmd == "chat" then
        local msg = cmdText:sub(6)
        if msg ~= "" then
            local rs = game:GetService("ReplicatedStorage")
            if rs:FindFirstChild("DefaultChatSystemChatEvents") then rs.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All") end
            ok = true
        end
    elseif cmd == "cmds" then
        local g = game:GetService("CoreGui"):FindFirstChild("CMDS")
        if g and g:FindFirstChild("CMDSFRAME") then g.CMDSFRAME.Visible = true end; ok = true
    end
    return ok
end

local function executeCommand(cmdText)
    if not cmdText or cmdText == "" then notify("Digite um comando primeiro.") return end
    cmdText = cmdText:gsub("^;%s*", "")
    table.insert(getgenv().SiriguelaCmdHistory, 1, cmdText)
    if #getgenv().SiriguelaCmdHistory > 30 then table.remove(getgenv().SiriguelaCmdHistory) end
    local ok = execNative(cmdText)
    if not ok then
        pcall(function() if _G.SiriguelaAdminRun then _G.SiriguelaAdminRun(cmdText) end end)
        notify("Enviado: ;" .. cmdText)
    else
        notify("Executado: " .. cmdText)
    end
    if _G.SiriguelaRefreshHistory then _G.SiriguelaRefreshHistory() end
end

