local function corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

local function stroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or COLORS.red
    s.Thickness = thickness or 1
    s.Transparency = 0.25
    s.Parent = parent
    return s
end

local function make(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props or {}) do obj[k] = v end
    obj.Parent = parent
    return obj
end

local function label(parent, text, size, position, fontSize, color)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Size = size,
        Position = position,
        Text = text,
        TextColor3 = color or COLORS.text,
        Font = Enum.Font.Gotham,
        TextSize = fontSize or 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
    }, parent)
end

local function button(parent, text, size, position, callback, secondary)
    local b = make("TextButton", {
        Size = size,
        Position = position,
        BackgroundColor3 = secondary and COLORS.panel2 or COLORS.red2,
        Text = text,
        TextColor3 = COLORS.text,
        Font = Enum.Font.GothamSemibold,
        TextSize = 13,
        AutoButtonColor = true,
        BorderSizePixel = 0,
    }, parent)
    corner(b, 7)
    if not secondary then stroke(b, COLORS.red, 1) end
    b.Activated:Connect(function()
        if callback then callback() end
    end)
    return b
end

local function textbox(parent, placeholder, size, position)
    local t = make("TextBox", {
        Size = size,
        Position = position,
        BackgroundColor3 = COLORS.bg,
        TextColor3 = COLORS.text,
        PlaceholderColor3 = COLORS.muted,
        PlaceholderText = placeholder,
        Text = "",
        Font = Enum.Font.Gotham,
        TextSize = 14,
        ClearTextOnFocus = false,
        BorderSizePixel = 0,
    }, parent)
    corner(t, 7)
    stroke(t, COLORS.panel2, 1)
    return t
end

