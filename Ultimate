function _G.SiriguelaRefreshHistory()
    local txtLabel = historyCard:FindFirstChildWhichIsA("TextLabel", true)
    if not txtLabel then return end
    local h = getgenv().SiriguelaCmdHistory or {}
    if #h == 0 then txtLabel.Text = "Nenhum comando executado ainda."
    else
        local t = ""
        for i = 1, math.min(5, #h) do t = t .. (i > 1 and "\n" or "") .. i .. ". " .. h[i] end
        txtLabel.Text = t
    end
end

