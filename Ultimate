local tornadoActive = false
local tornadoRadius = 50
local tornadoHeight = 5
local tornadoRotationSpeed = 0.25
local tornadoAttractionStrength = 750
local tornadoParts = {}

if not getgenv().Network then
    getgenv().Network = { BaseParts = {}, Velocity = Vector3.new(14.46262424, 14.46262424, 14.46262424) }
    Network.RetainPart = function(Part)
        if typeof(Part) == "Instance" and Part:IsA("BasePart") and Part:IsDescendantOf(Workspace) then
            table.insert(Network.BaseParts, Part)
            Part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
            Part.CanCollide = false
        end
    end
    RunService.Heartbeat:Connect(function()
        pcall(function() sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge) end)
        for _, Part in pairs(Network.BaseParts) do
            if Part:IsDescendantOf(Workspace) then Part.Velocity = Network.Velocity end
        end
    end)
end

local function RetainPart(Part)
    if Part:IsA("BasePart") and not Part.Anchored and Part:IsDescendantOf(workspace) then
        if Part.Parent == LocalPlayer.Character or Part:IsDescendantOf(LocalPlayer.Character) then return false end
        Part.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        Part.CanCollide = false
        return true
    end
    return false
end
local function addPart(part)
    if RetainPart(part) then
        if not table.find(tornadoParts, part) then table.insert(tornadoParts, part) end
    end
end
local function removePart(part)
    local index = table.find(tornadoParts, part)
    if index then table.remove(tornadoParts, index) end
end
for _, part in pairs(workspace:GetDescendants()) do addPart(part) end
workspace.DescendantAdded:Connect(addPart)
workspace.DescendantRemoving:Connect(removePart)

RunService.Heartbeat:Connect(function()
    if not tornadoActive then return end
    local targetHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if targetHRP then
        local center = targetHRP.Position
        for _, part in pairs(tornadoParts) do
            if part.Parent and not part.Anchored then
                local pos = part.Position
                local distance = (Vector3.new(pos.X, center.Y, pos.Z) - center).Magnitude
                local angle = math.atan2(pos.Z - center.Z, pos.X - center.X)
                local newAngle = angle + math.rad(tornadoRotationSpeed)
                local targetPos = Vector3.new(
                    center.X + math.cos(newAngle) * math.min(tornadoRadius, distance),
                    center.Y + (tornadoHeight * (math.abs(math.sin((pos.Y - center.Y) / tornadoHeight)))),
                    center.Z + math.sin(newAngle) * math.min(tornadoRadius, distance)
                )
                local dir = (targetPos - part.Position).unit
                part.Velocity = dir * tornadoAttractionStrength
            end
        end
    end
end)

