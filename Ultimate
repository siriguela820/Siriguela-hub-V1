function refreshPlayers()
    for _, child in ipairs(playerScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local query = string.lower(playerSearch.Text or "")
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and (query == "" or string.find(string.lower(plr.Name), query, 1, true)
            or string.find(string.lower(plr.DisplayName), query, 1, true)) then
            local b = button(playerScroll, plr.DisplayName .. " (@" .. plr.Name .. ")", UDim2.new(1, -2, 0, 31), UDim2.new(), function()
                selectedPlayer = plr
                local textLabel = selectedLabel:FindFirstChildWhichIsA("TextLabel")
                if textLabel then textLabel.Text = "Alvo: " .. plr.Name end
                notify("Selecionado: " .. plr.Name)
            end, true)
            b.TextXAlignment = Enum.TextXAlignment.Left
        end
    end
end
