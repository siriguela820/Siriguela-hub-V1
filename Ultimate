    TextSize = 22,
    BorderSizePixel = 0,
    AutoButtonColor = true,
    Visible = false,
    ZIndex = 20,
}, gui)
corner(miniBtn, 10)
stroke(miniBtn, COLORS.red, 1.5)

local miniDragging = false
local miniDragStart = nil
local miniStartPos = nil
local miniMoved = false

miniBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        miniDragging = true
        miniDragStart = input.Position
        miniStartPos = miniBtn.Position
        miniMoved = false
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                miniDragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if miniDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - miniDragStart
        if delta.Magnitude > 6 then miniMoved = true end
        miniBtn.Position = UDim2.new(
            miniStartPos.X.Scale, miniStartPos.X.Offset + delta.X,
            miniStartPos.Y.Scale, miniStartPos.Y.Offset + delta.Y
        )
    end
end)

miniBtn.MouseButton1Click:Connect(function()
    if not miniMoved then
        main.Visible = true
        miniBtn.Visible = false
    end
end)

minimize.Activated:Connect(function()
    main.Visible = false
    miniBtn.Visible = true
end)

-- RightShift alterna minimizado/visível
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift and gui.Parent then
        if main.Visible then
            main.Visible = false
            miniBtn.Visible = true
        else
            main.Visible = true
            miniBtn.Visible = false
        end
    end
end)

