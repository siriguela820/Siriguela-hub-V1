local function numericPopup(titleText, hintText, currentVal, callback, minV, maxV)
    local screen = Instance.new("ScreenGui", PlayerGui)
    screen.Name = "TornadoNumPrompt"
    screen.ResetOnSpawn = false
    local bg = Instance.new("TextButton")
    bg.Size = UDim2.new(1, 0, 1, 0); bg.BackgroundColor3 = Color3.new(0,0,0)
    bg.BackgroundTransparency = 0.5; bg.BorderSizePixel = 0; bg.Text = ""
    bg.Parent = screen
    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 320, 0, 140); box.Position = UDim2.new(0.5, -160, 0.5, -70)
    box.BackgroundColor3 = COLORS.bg; box.BorderSizePixel = 0
    corner(box, 10); stroke(box, COLORS.red, 1.5); box.Parent = screen
    local tl = label(box, titleText.." (atual: "..currentVal..")", UDim2.new(1, -20, 0, 28), UDim2.new(0, 10, 0, 8), 14)
    tl.Font = Enum.Font.GothamBold
    label(box, hintText, UDim2.new(1, -20, 0, 16), UDim2.new(0, 10, 0, 34), 11, COLORS.muted)
    local inp = textbox(box, "Novo valor...", UDim2.new(1, -20, 0, 34), UDim2.new(0, 10, 0, 54))
    inp:CaptureFocus()
    local function aplicar()
        local n = tonumber(inp.Text)
        if n then callback(math.clamp(n, minV, maxV)) end
        screen:Destroy()
    end
    button(box, "Aplicar", UDim2.new(0.45, -5, 0, 30), UDim2.new(0, 10, 1, -40), aplicar)
    button(box, "Cancelar", UDim2.new(0.45, -5, 0, 30), UDim2.new(0.55, 5, 1, -40), function() screen:Destroy() end, true)
    inp.FocusLost:Connect(function(enter) if enter then aplicar() end end)
    bg.Activated:Connect(function() screen:Destroy() end)
end

