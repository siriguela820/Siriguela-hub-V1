local function runCommandEntry(entry)
    if entry.arg == "none" then executeCommand(entry.cmd) return end
    local screen = Instance.new("ScreenGui", PlayerGui)
    screen.Name = "SiriguelaArgPrompt"
    screen.ResetOnSpawn = false

    local bg = Instance.new("TextButton")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.new(0, 0, 0)
    bg.BackgroundTransparency = 0.5
    bg.BorderSizePixel = 0
    bg.Text = ""
    bg.Parent = screen

    local box = Instance.new("Frame")
    box.Size = UDim2.new(0, 320, 0, 160)
    box.Position = UDim2.new(0.5, -160, 0.5, -80)
    box.BackgroundColor3 = COLORS.bg
    box.BorderSizePixel = 0
    corner(box, 10)
    stroke(box, COLORS.red, 1.5)
    box.Parent = screen

    local tl = label(box, "Comando: " .. entry.cmd, UDim2.new(1, -20, 0, 28), UDim2.new(0, 10, 0, 8), 15)
    tl.Font = Enum.Font.GothamBold

    local hint = ""
    if entry.arg == "player" then hint = "Nome do jogador (ou 'all'/'others'/'me')"
    elseif entry.arg == "number" then hint = "Digite um número"
    elseif entry.arg == "text" then hint = "Digite o texto" end
    label(box, hint, UDim2.new(1, -20, 0, 18), UDim2.new(0, 10, 0, 36), 11, COLORS.muted)

    local argInput = textbox(box, "...", UDim2.new(1, -20, 0, 34), UDim2.new(0, 10, 0, 58))
    argInput:CaptureFocus()

    button(box, "Executar", UDim2.new(0.45, -5, 0, 30), UDim2.new(0, 10, 1, -40), function()
        local val = argInput.Text
        if val == "" then notify("Digite um valor.") return end
        screen:Destroy()
        executeCommand(entry.cmd .. " " .. val)
    end)
    button(box, "Cancelar", UDim2.new(0.45, -5, 0, 30), UDim2.new(0.55, 5, 1, -40), function()
        screen:Destroy()
    end, true)

    argInput.FocusLost:Connect(function(enter)
        if enter and argInput.Text ~= "" then
            local val = argInput.Text
            screen:Destroy()
            executeCommand(entry.cmd .. " " .. val)
        end
    end)
    bg.Activated:Connect(function() screen:Destroy() end)
end

local function refreshCmdList(filter)
    for _, child in ipairs(cmdScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    filter = (filter or ""):lower()
    local shown = 0
    for _, entry in ipairs(commandList) do
        local matches = filter == "" or entry.cmd:lower():find(filter, 1, true) or entry.desc:lower():find(filter, 1, true)
        if matches then
            shown = shown + 1
            local btn = make("TextButton", {
                Size = UDim2.new(1, -2, 0, 44),
                BackgroundColor3 = COLORS.panel2, Text = "", BorderSizePixel = 0, AutoButtonColor = true,
            }, cmdScroll)
            corner(btn, 6)
            local nameLbl = label(btn, entry.cmd, UDim2.new(1, -10, 0, 18), UDim2.new(0, 8, 0, 4), 13)
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextColor3 = COLORS.red
            label(btn, entry.desc, UDim2.new(1, -10, 0, 18), UDim2.new(0, 8, 0, 22), 10, COLORS.muted)
            btn.Activated:Connect(function() runCommandEntry(entry) end)
        end
    end
    if shown == 0 then
        local empty = label(cmdScroll, "Nenhum comando encontrado para: '" .. filter .. "'", UDim2.new(1, -4, 0, 40), UDim2.new(0, 4, 0, 4), 12, COLORS.muted)
