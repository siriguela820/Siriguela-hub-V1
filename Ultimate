local function RunAdminCommand(msg)
    if not msg or msg == "" then return false end
    if msg:sub(1,5) == "kill " then
        if msg:sub(6) == "me" then
            if lplayer.Character then lplayer.Character.HumanoidRootPart.CFrame = CFrame.new(100000,0,100000) end
        else
            for _, v in pairs(GetPlayer(msg:sub(6))) do
                if not (lplayer.Character and v.Character) then break end
                local NOW = lplayer.Character.HumanoidRootPart.CFrame
                lplayer.Character.Humanoid.Name = "1"
                local l = lplayer.Character["1"]:Clone()
                l.Parent = lplayer.Character; l.Name = "Humanoid"
                task.wait(0.1); lplayer.Character["1"]:Destroy()
                workspace.CurrentCamera.CameraSubject = lplayer.Character
                for _, t in pairs(lplayer.Backpack:GetChildren()) do
                    if t:IsA("Tool") then lplayer.Character.Humanoid:EquipTool(t) end
                end
                task.wait(0.1)
                lplayer.Character.HumanoidRootPart.CFrame = v.Character.HumanoidRootPart.CFrame
                task.wait(0.2)
                lplayer.Character.HumanoidRootPart.CFrame = v.Character.HumanoidRootPart.CFrame
                task.wait(0.5)
                lplayer.Character.HumanoidRootPart.CFrame = CFrame.new(-100000,10,-100000)
                task.wait(0.7)
                lplayer.Character:MoveTo(v.Character.Head.Position)
                task.wait(0.7)
                lplayer.Character.HumanoidRootPart.CFrame = NOW
            end
        end
        return true
    end
    if msg:sub(1,6) == "bring " then
        for _, v in pairs(GetPlayer(msg:sub(7))) do
            if not (lplayer.Character and v.Character) then break end
            local NOW = lplayer.Character.HumanoidRootPart.CFrame
            lplayer.Character.Humanoid.Name = "1"
            local l = lplayer.Character["1"]:Clone()
            l.Parent = lplayer.Character; l.Name = "Humanoid"
            task.wait(0.1); lplayer.Character["1"]:Destroy()
            for _, t in pairs(lplayer.Backpack:GetChildren()) do
                if t:IsA("Tool") then lplayer.Character.Humanoid:EquipTool(t) end
            end
            v.Character.HumanoidRootPart.CFrame = lplayer.Character.HumanoidRootPart.CFrame
            task.wait(0.2)
            v.Character.HumanoidRootPart.CFrame = lplayer.Character.HumanoidRootPart.CFrame
            task.wait(0.5)
            lplayer.Character.HumanoidRootPart.CFrame = NOW
            task.wait(0.5)
            lplayer.Character:MoveTo(v.Character.Head.Position)
            task.wait(0.3)
            lplayer.Character.HumanoidRootPart.CFrame = NOW
        end
        return true
    end
    if msg:sub(1,6) == "fling " then
        for _, v in pairs(GetPlayer(msg:sub(7))) do
            if not (lplayer.Character and v.Character) then break end
            local y = Instance.new("RocketPropulsion")
            y.Parent = lplayer.Character.HumanoidRootPart
            y.CartoonFactor = 1; y.MaxThrust = 800000; y.MaxSpeed = 1000; y.ThrustP = 200000
            y.Name = "Fling"
            workspace.CurrentCamera.CameraSubject = v.Character.Head
            y.Target = v.Character.HumanoidRootPart
            y:Fire()
            noclip = true
        end
        return true
    end
    if msg:sub(1,7) == "unfling" then
        noclip = false
        if lplayer.Character then
            local f = lplayer.Character.HumanoidRootPart:FindFirstChild("Fling")
            if f then f:Destroy() end
            workspace.CurrentCamera.CameraSubject = lplayer.Character:FindFirstChildOfClass("Humanoid")
        end
        return true
    end
    if msg:sub(1,5) == "void " then
